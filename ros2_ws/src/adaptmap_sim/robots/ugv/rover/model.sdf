<?xml version="1.0"?>
<!-- P9: a bigger platform than the rover. Four-wheel skid steer, body 1.40 x 0.95 x 0.35 m, LiDAR (same
     64-beam sensor as the rover) on a short mast 0.35 m ahead of the centre, 1.30 m above the ground.
     Its profile is configs/robots/ugv.yaml; select it with robot:=ugv on the launch files. -->
<sdf version="1.9">
  <model name="ugv">
    <link name="base_link">
      <pose>0 0 0.37 0 0 0</pose>
      <inertial><mass>90</mass><inertia><ixx>6</ixx><iyy>12</iyy><izz>15</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>1.4 0.95 0.35</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.4 0.95 0.35</size></box></geometry>
        <material><ambient>0.15 0.45 0.75 1</ambient><diffuse>0.15 0.45 0.75 1</diffuse></material></visual>
      <visual name="rack"><pose>-0.25 0 0.22 0 0 0</pose><geometry><box><size>0.7 0.8 0.1</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      <visual name="mast"><pose>0.35 0 0.5 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>0.65</length></cylinder></geometry></visual>
    </link>
    <link name="lidar_link">
      <pose>0.35 0 1.30 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>0.06</radius><length>0.08</length></cylinder></geometry></visual>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_link</gz_frame_id>
        <topic>/lidar</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal><samples>2048</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>64</samples><resolution>1</resolution><min_angle>-0.4329</min_angle><max_angle>0.0349</max_angle></vertical>
          </scan>
          <range><min>0.5</min><max>100.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
    <link name="wheel_fl">
      <pose>0.45 0.4 0.2 -1.5707 0 0</pose>
      <inertial><mass>4</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
    </link>
    <joint name="wheel_fl_joint" type="revolute"><parent>base_link</parent><child>wheel_fl</child><axis><xyz>0 0 1</xyz></axis></joint>
    <link name="wheel_rl">
      <pose>-0.45 0.4 0.2 -1.5707 0 0</pose>
      <inertial><mass>4</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
    </link>
    <joint name="wheel_rl_joint" type="revolute"><parent>base_link</parent><child>wheel_rl</child><axis><xyz>0 0 1</xyz></axis></joint>
    <link name="wheel_fr">
      <pose>0.45 -0.4 0.2 -1.5707 0 0</pose>
      <inertial><mass>4</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
    </link>
    <joint name="wheel_fr_joint" type="revolute"><parent>base_link</parent><child>wheel_fr</child><axis><xyz>0 0 1</xyz></axis></joint>
    <link name="wheel_rr">
      <pose>-0.45 -0.4 0.2 -1.5707 0 0</pose>
      <inertial><mass>4</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
    </link>
    <joint name="wheel_rr_joint" type="revolute"><parent>base_link</parent><child>wheel_rr</child><axis><xyz>0 0 1</xyz></axis></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint><left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint><right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.8</wheel_separation><wheel_radius>0.2</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <topic>/cmd_vel</topic><odom_publish_frequency>0</odom_publish_frequency>
    </plugin>
    <!-- ground-truth odometry + odom->base_link TF, like the rover -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame><robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency><dimensions>3</dimensions>
      <odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
    </plugin>
  </model>
</sdf>
